# Token của Discord Bot (Lấy từ Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Client ID của ứng dụng
CLIENT_ID=your_client_id_here
GUILD_ID=your_test_guild_id_here

# Turso Cloud Database
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Cấu hình Bộ đệm Dữ liệu Turso trên Hosting (Embedded Replica & Đồng bộ định kỳ)
TURSO_CACHE_ENABLED=true
TURSO_CACHE_DB_PATH=./data/turso_cache.db
TURSO_CACHE_SYNC_INTERVAL_MINUTES=10

# Admin Panel
ADMIN_HOST=0.0.0.0
ADMIN_PORT=3000
ADMIN_TRUST_PROXY=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_password_at_least_16_chars
START_ADMIN_WITH_BOT=false
BOT_OWNER_ID=your_discord_user_id
